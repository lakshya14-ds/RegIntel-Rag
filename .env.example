# LLM Generation Provider Configuration (Phases 48-49)
LLM_PROVIDER=gemini
LLM_FALLBACK_ENABLED=false
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=models/gemini-flash-lite-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30.0

# Embedding Provider Configuration (Independent of LLM Provider)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Database Configuration
MONGODB_URI=
MONGODB_DB=regintel
MONGODB_COLLECTION=documents
MONGODB_CHUNKS_COLLECTION=chunks

# Observability Configuration (Phases 32, 33, 50)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_PROMPTS=false
LANGFUSE_CAPTURE_RETRIEVED_CONTENT=false
LANGFUSE_MAX_CONTENT_LENGTH=5000
ENVIRONMENT=production
MLFLOW_ENABLED=true
MLFLOW_EXPERIMENT_NAME=RegIntel-RAG

# Server & Network Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
DEBUG=false
