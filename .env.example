MONGODB_COLLECTION=documents
MONGODB_CHUNKS_COLLECTION=chunks

# Observability Configuration
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
